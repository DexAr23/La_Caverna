---
// src/layouts/MainLayout.astro
interface Props {
	title?: string;
}

const { title = "La Caverna | Librería" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot /> 
		
		<div id="toast-container"></div>

		<style is:global>
			:root {
				--bg-main: #151515;
				--bg-panel: #241913;
				--bg-panel-soft: #34261e;
				--text-main: #f5f5dc;
				--text-muted: #b9b2a6;
				--accent-color: #8b5e3c;
				--border-color: rgba(139, 94, 60, 0.72);
				--panel-stroke: rgba(245, 245, 220, 0.08);
				--panel-shadow: 0 22px 45px rgba(0, 0, 0, 0.28);
				--overlay-dark: rgba(20, 16, 12, 0.45);
				--font-body: 'Inter', sans-serif;
				--font-display: 'Lora', serif;

				/* Compatibilidad con componentes existentes */
				--blanco: var(--text-main);
				--crema-claro: var(--bg-main);
				--crema-detalle: var(--bg-panel);
				--marron-suave: #d2b48c;
				--marron-caverna: var(--accent-color);
				--texto: #0f0f0f;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				background:
					radial-gradient(circle at top, rgba(139, 94, 60, 0.16), transparent 32%),
					linear-gradient(180deg, #171311 0%, var(--bg-main) 45%, #120f0d 100%);
				color: var(--text-main);
				font-family: var(--font-body);
				line-height: 1.6;
				min-height: 100vh;
			}

			h1, h2, h3 {
				font-family: var(--font-display);
				color: var(--text-main);
			}

			/* Estilos para el Toast Container */
			#toast-container {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				z-index: 1000;
			}
		</style>
	</body>
</html>
