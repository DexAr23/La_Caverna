---
// src/layouts/MainLayout.astro
interface Props {
	title?: string;
}

const { title = "La Caverna | Librería" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot /> 
		
		<div id="toast-container"></div>

		<style is:global>
			:root {
				--blanco: #ffffff;
				--crema-claro: #fdfaf5;
				--crema-detalle: #f5f5dc;
				--marron-suave: #d2b48c;
				--marron-caverna: #8b5e3c;
				--texto: #2c2c2c;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				background-color: var(--blanco);
				color: var(--texto);
				font-family: 'Inter', sans-serif;
				line-height: 1.6;
			}

			h1, h2, h3 {
				font-family: 'Lora', serif;
				color: var(--marron-caverna);
			}

			/* Estilos para el Toast Container */
			#toast-container {
				position: fixed;
				bottom: 2rem;
				right: 2rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				z-index: 1000;
			}
		</style>
	</body>
</html>