---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';
import Nav_Bar from '../components/Nav-Bar.astro';
import Cart from '../components/Cart.astro';
import Filtre from '../components/Filtre.astro';
import * as xsltProcessor from 'xslt-processor';
import fs from 'node:fs/promises';
import path from 'node:path';

const xmlPath = path.join(process.cwd(), 'src/data/libreria.xml');
const xslPath = path.join(process.cwd(), 'src/data/transform.xsl');

let htmlResultado = '';

try {
    const url = new URL(Astro.request.url);
    
    // 1. CAPTURAR DATOS
    const search = url.searchParams.get('search') || '';
    const catsArray = url.searchParams.getAll('cat'); 
    const catsString = catsArray.length > 0 ? `|${catsArray.join('|')}|` : '|Todos|';
    const minP = url.searchParams.get('min') || '0';
    const maxP = url.searchParams.get('max') || '999';
    const order = url.searchParams.get('sort') === 'descending' ? 'descending' : 'ascending';

    // 2. LEER ARCHIVOS
    const xmlRaw = await fs.readFile(xmlPath, 'utf-8');
    const xslRaw = await fs.readFile(xslPath, 'utf-8');

    let xslt = new xsltProcessor.Xslt();
    const xmlParser = new xsltProcessor.XmlParser();

    const xmlParsed = xmlParser.xmlParse(xmlRaw);
    const xslParsed = xmlParser.xmlParse(xslRaw);
    
    // 3. FORMATO DE PARÁMETROS ALTERNATIVO (Array de objetos)
    // Probamos este formato que es el que exige la v5 para que el XSLT los reciba
    const parametros = [
        { name: 'busqueda', value: search },
        { name: 'catsSeleccionadas', value: catsString },
        { name: 'minPrecio', value: Number(minP) },
        { name: 'maxPrecio', value: Number(maxP) },
        { name: 'orden', value: order }
    ];

    xslt = new xsltProcessor.Xslt({ parameters: parametros });

    // 4. PROCESAR
    const resultadoReal = await xslt.xsltProcess(xmlParsed, xslParsed);
    
    if (resultadoReal && resultadoReal.length > 0) {
        htmlResultado = resultadoReal;
    } else {
        htmlResultado = "<h1 style='color:orange;'>No se han encontrado libros con esos filtros.</h1>";
    }

} catch (error) {
    console.error("Error detallado:", error);
    const msg = error instanceof Error ? error.message : "Error desconocido";
    htmlResultado = `<p style="color:red;">Error: ${msg}</p>`;
}
---

<MainLayout title="La Caverna - Inicio">
    <Nav_Bar />
    <Cart />

    <Filtre />
    <section class="coleccion-libros" set:html={htmlResultado} />
</MainLayout>

<style is:global>

    /* El contenedor que envuelve todas las cards */

    .coleccion-libros {

        display: flex;

        flex-wrap: wrap;

        gap: 50px;

        padding: 0;

        margin-top: 200px;

        justify-content: center;

        align-items: center;

        text-align: center;

        margin-left: auto;

        margin-right: auto;

        background-color: transparent;

        min-height: 100vh;

        max-width: 80vw;

    }



    /* Cada tarjeta de libro */

    .card {

        background: linear-gradient(180deg, var(--bg-panel-soft) 0%, var(--bg-panel) 100%);

        border: 1px solid var(--border-color);

        border-radius: 16px;

        padding: 1.5rem;

        display: flex;

        flex-direction: column;

        transition: all 0.3s ease;

        box-shadow: var(--panel-shadow);

        width: 250px;

        height: 400px;

    }



    .card:hover {

        transform: translateY(-8px);

        box-shadow: 0 18px 30px rgba(0, 0, 0, 0.32);

        border-color: var(--accent-color);

    }



    /* Ajuste de la imagen */

    .card img {

        align-self: center;

       

        height: 200px;

        object-fit: cover;

        border-radius: 6px;

        background-color: rgba(255, 255, 255, 0.08); /* Por si la API de portadas falla */

        margin-bottom: 1rem;

    }

    .card figure {

        display: flex;

        flex-direction: column;

        height: 100%;

    }

    .card-link {

        display: flex;

        flex-direction: column;

        color: inherit;

        text-decoration: none;

        height: 100%;

    }

    .card h3 {

        color: var(--text-main);

        margin-bottom: 0.35rem;

    }

    .card .author {

        color: var(--text-muted);

        font-size: 0.95rem;

    }



    /* El botón del carrito */

    .add-to-cart {

        margin-top: auto;

        background-color: var(--accent-color);

        color: var(--text-main);

        border: none;

        padding: 0.8rem;

        border-radius: 6px;

        cursor: pointer;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 0.5rem;

        font-weight: 600;

        transition: background 0.2s;

    }



    .add-to-cart:hover {

        background-color: #a36c42;

    }

    @media (max-width: 1024px) {

        .coleccion-libros {

        padding: 10px;

        gap: 20px;;

    }

    .card{

        zoom: 0.7;

    }

    }

    @media (max-width: 768px) {

    .card{

        zoom: 0.6;

    }

    }

</style>
