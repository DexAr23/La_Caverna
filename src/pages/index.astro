---
import MainLayout from '../layouts/MainLayout.astro';
// Cambiamos el import a este formato para evitar líos de tipos
import * as xsltProcessor from 'xslt-processor';
import fs from 'node:fs/promises';
import path from 'node:path';

const xmlPath = path.join(process.cwd(), 'src/data/libreria.xml');
const xslPath = path.join(process.cwd(), 'src/data/transform.xsl');

let htmlResultado = '';

try {
    const xmlRaw = await fs.readFile(xmlPath, 'utf-8');
    const xslRaw = await fs.readFile(xslPath, 'utf-8');

    const xslt = new xsltProcessor.Xslt();
    const xmlParser = new xsltProcessor.XmlParser();

    const xmlParsed = xmlParser.xmlParse(xmlRaw);
    const xslParsed = xmlParser.xmlParse(xslRaw);
    
    // CAMBIO AQUÍ: Cambiamos .process por .xsltProcess
    // @ts-ignore
    const resultadoReal = await xslt.xsltProcess(xmlParsed, xslParsed);
    
    if (resultadoReal && resultadoReal.length > 0) {
        htmlResultado = resultadoReal;
    } else {
        htmlResultado = "<h1 style='color:orange;'>El XSLT devolvió un texto vacío. Revisa el match='//libro' en tu XSL.</h1>";
    }

} catch (error) {
    console.error("Error detallado:", error);
    htmlResultado = `<p style="color:red;">Error: ${error.message}</p>`;
}
---

<MainLayout title="La Caverna - Inicio">
    <section class="coleccion-libros" set:html={htmlResultado} />
</MainLayout>
<style is:global>
    /* El contenedor que envuelve todas las cards */
    .coleccion-libros {
        display: flex;
        flex-wrap: wrap;
        gap: 50px;
        padding: 3rem 5vw;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin-left: auto;
        margin-right: auto;
        background-color: var(--crema-claro);
        min-height: 100vh;
        max-width: 80vw;
    }

    /* Cada tarjeta de libro */
    .card {
        background-color: var(--blanco);
        border: 5px solid var(--marron-suave);
        border-color: black;
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        width: 250px;
        height: 400px;
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 25px rgba(139, 94, 60, 0.15);
        border-color: var(--marron-caverna);
    }

    /* Ajuste de la imagen */
    .card img {
        align-self: center;
       
        height: 200px;
        object-fit: cover;
        border-radius: 6px;
        background-color: #eee; /* Por si la API de portadas falla */
        margin-bottom: 1rem;
    }

    /* El botón del carrito */
    .add-to-cart {
        margin-top: auto;
        background-color: var(--marron-caverna);
        color: var(--blanco);
        border: none;
        padding: 0.8rem;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 600;
        transition: background 0.2s;
    }

    .add-to-cart:hover {
        background-color: var(--texto);
    }
</style>