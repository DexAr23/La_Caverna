---
const storageKey = 'la-caverna-cart';
---

<div class="cart-backdrop" data-cart-backdrop></div>

<aside class="cart-drawer" data-cart-drawer aria-hidden="true">
    <header class="cart-header">
        <div>
            <p class="cart-kicker">Tu cesta</p>
            <h2>Carrito de libros</h2>
        </div>
        <button class="cart-close" type="button" data-cart-close aria-label="Cerrar carrito">
            <span aria-hidden="true">&times;</span>
        </button>
    </header>

    <div class="cart-body" data-cart-body>
        <p class="cart-empty" data-cart-empty>Tu carrito está vacío. Añade algunos títulos para empezar.</p>
        <div class="cart-items" data-cart-items></div>
    </div>

    <footer class="cart-footer">
        <div class="cart-summary-row">
            <span>Precio medio</span>
            <strong data-cart-average>0,00 EUR</strong>
        </div>
        <div class="cart-summary-row cart-summary-total">
            <span>Total</span>
            <strong data-cart-total>0,00 EUR</strong>
        </div>
        <button class="cart-checkout" type="button" data-cart-checkout disabled>
            Comprar
        </button>
    </footer>
</aside>

<script define:vars={{ storageKey }}>
    (() => {
        const globalKey = '__laCavernaCartController';

        if (window[globalKey]?.destroy) {
            window[globalKey].destroy();
        }

        const formatPrice = (value) =>
            new Intl.NumberFormat('es-ES', {
                style: 'currency',
                currency: 'EUR',
            }).format(value);

        const parsePrice = (rawValue) => {
            const normalized = String(rawValue ?? '')
                .replace(',', '.')
                .replace(/[^\d.-]/g, '');

            const parsed = Number.parseFloat(normalized);
            return Number.isFinite(parsed) ? parsed : 0;
        };

        const escapeHtml = (value) =>
            String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

        const readCart = () => {
            try {
                const rawCart = localStorage.getItem(storageKey);
                const parsedCart = rawCart ? JSON.parse(rawCart) : [];
                return Array.isArray(parsedCart) ? parsedCart : [];
            } catch {
                return [];
            }
        };

        const writeCart = (items) => {
            localStorage.setItem(storageKey, JSON.stringify(items));
        };

        const showToast = (message) => {
            const container = document.querySelector('#toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'cart-toast';
            toast.textContent = message;
            container.appendChild(toast);

            requestAnimationFrame(() => toast.classList.add('visible'));

            window.setTimeout(() => {
                toast.classList.remove('visible');
                window.setTimeout(() => toast.remove(), 200);
            }, 1800);
        };

        const controller = {
            items: readCart(),
            refs: {},
            bind() {
                this.refs.drawer = document.querySelector('[data-cart-drawer]');
                this.refs.backdrop = document.querySelector('[data-cart-backdrop]');
                this.refs.items = document.querySelector('[data-cart-items]');
                this.refs.empty = document.querySelector('[data-cart-empty]');
                this.refs.average = document.querySelector('[data-cart-average]');
                this.refs.total = document.querySelector('[data-cart-total]');
                this.refs.checkout = document.querySelector('[data-cart-checkout]');
                this.refs.cartButton = document.querySelector('#btn-cart');
                this.refs.count = document.querySelector('[data-cart-count]');
            },
            open() {
                if (!this.refs.drawer) return;
                this.refs.drawer.classList.add('open');
                this.refs.backdrop?.classList.add('open');
                this.refs.drawer.setAttribute('aria-hidden', 'false');
                document.body.classList.add('cart-drawer-open');
            },
            close() {
                if (!this.refs.drawer) return;
                this.refs.drawer.classList.remove('open');
                this.refs.backdrop?.classList.remove('open');
                this.refs.drawer.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('cart-drawer-open');
            },
            save() {
                writeCart(this.items);
                this.render();
            },
            add(item) {
                this.items = [item, ...this.items];
                this.save();
                this.open();
                showToast(`"${item.title}" se ha añadido al carrito.`);
            },
            remove(id) {
                const removedItem = this.items.find((item) => item.cartLineId === id);
                this.items = this.items.filter((item) => item.cartLineId !== id);
                this.save();
                if (removedItem) {
                    showToast(`"${removedItem.title}" se ha eliminado del carrito.`);
                }
            },
            clear() {
                this.items = [];
                this.save();
            },
            getBookFromButton(button) {
                const card = button.closest('.card');
                if (!card) return null;

                const image = card.querySelector('img');
                const titleNode = card.querySelector('h3');
                const authorNode = card.querySelector('.author');
                const id = button.dataset.id || `book-${Date.now()}`;
                const price = parsePrice(button.dataset.precio);

                return {
                    cartLineId: `${id}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
                    id,
                    title: titleNode?.textContent?.trim() || image?.getAttribute('alt') || 'Libro',
                    author: authorNode?.textContent?.trim() || 'Autor desconocido',
                    cover: image?.getAttribute('src') || '',
                    price,
                };
            },
            render() {
                if (!this.refs.items) return;

                const itemCount = this.items.length;
                const total = this.items.reduce((sum, item) => sum + item.price, 0);
                const average = itemCount > 0 ? total / itemCount : 0;

                this.refs.items.innerHTML = this.items
                    .map(
                        (item) => `
                            <article class="cart-item" data-cart-item>
                                <img
                                    class="cart-item-cover"
                                    src="${escapeHtml(item.cover)}"
                                    alt="${escapeHtml(item.title)}"
                                    loading="lazy"
                                    onerror="this.onerror=null;this.src='https://placehold.co/300x450/241913/f5f5dc?text=Sin+Portada';"
                                />
                                <div class="cart-item-copy">
                                    <h3>${escapeHtml(item.title)}</h3>
                                    <p>${escapeHtml(item.author)}</p>
                                </div>
                                <div class="cart-item-meta">
                                    <strong>${formatPrice(item.price)}</strong>
                                    <button
                                        class="cart-remove"
                                        type="button"
                                        data-cart-remove="${item.cartLineId}"
                                        aria-label="Eliminar ${escapeHtml(item.title)} del carrito"
                                    >
                                        Eliminar
                                    </button>
                                </div>
                            </article>
                        `
                    )
                    .join('');

                if (this.refs.empty) {
                    this.refs.empty.hidden = itemCount > 0;
                }

                if (this.refs.average) {
                    this.refs.average.textContent = formatPrice(average);
                }

                if (this.refs.total) {
                    this.refs.total.textContent = formatPrice(total);
                }

                if (this.refs.checkout) {
                    this.refs.checkout.disabled = itemCount === 0;
                    this.refs.checkout.textContent =
                        itemCount === 0 ? 'Comprar' : `Comprar (${itemCount})`;
                }

                if (this.refs.count) {
                    this.refs.count.textContent = String(itemCount);
                    this.refs.count.hidden = itemCount === 0;
                }
            },
            onDocumentClick(event) {
                const target = event.target;
                if (!(target instanceof HTMLElement)) return;

                const addButton = target.closest('.add-to-cart');
                if (addButton instanceof HTMLButtonElement) {
                    const book = this.getBookFromButton(addButton);
                    if (book) {
                        this.add(book);
                    }
                    return;
                }

                if (target.closest('#btn-cart')) {
                    this.refs.drawer?.classList.contains('open') ? this.close() : this.open();
                    return;
                }

                if (target.closest('[data-cart-close]') || target.closest('[data-cart-backdrop]')) {
                    this.close();
                    return;
                }

                const removeButton = target.closest('[data-cart-remove]');
                if (removeButton instanceof HTMLButtonElement) {
                    this.remove(removeButton.dataset.cartRemove);
                    return;
                }

                if (target.closest('[data-cart-checkout]')) {
                    if (this.items.length === 0) return;
                    showToast(`Pedido preparado con ${this.items.length} libro(s).`);
                    this.clear();
                    this.close();
                }
            },
            onKeyDown(event) {
                if (event.key === 'Escape') {
                    this.close();
                }
            },
            onAfterSwap() {
                this.bind();
                this.render();
            },
            init() {
                this.bind();
                this.render();
                document.addEventListener('click', this.onDocumentClickBound);
                document.addEventListener('keydown', this.onKeyDownBound);
                document.addEventListener('astro:after-swap', this.onAfterSwapBound);
            },
            destroy() {
                document.removeEventListener('click', this.onDocumentClickBound);
                document.removeEventListener('keydown', this.onKeyDownBound);
                document.removeEventListener('astro:after-swap', this.onAfterSwapBound);
                document.body.classList.remove('cart-drawer-open');
            },
        };

        controller.onDocumentClickBound = controller.onDocumentClick.bind(controller);
        controller.onKeyDownBound = controller.onKeyDown.bind(controller);
        controller.onAfterSwapBound = controller.onAfterSwap.bind(controller);
        controller.init();

        window[globalKey] = controller;
    })();
</script>

<style>
    .cart-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(20, 16, 12, 0.45);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 1090;
    }

    .cart-backdrop.open {
        opacity: 1;
        pointer-events: auto;
    }

    .cart-drawer {
        position: fixed;
        top: 150px;
        right: 0;
        width: min(380px, calc(100vw - 24px));
        max-height: calc(100vh - 180px);
        display: flex;
        flex-direction: column;
        background: linear-gradient(180deg, #34261e 0%, #241913 100%);
        color: var(--crema-claro);
        border: 4px solid var(--marron-caverna);
        border-radius: 16px 0 0 16px;
        box-shadow: 0 22px 45px rgba(0, 0, 0, 0.28);
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1100;
        overflow: hidden;
    }

    .cart-drawer.open {
        transform: translateX(0);
    }

    .cart-header,
    .cart-footer {
        padding: 1.25rem;
        background-color: rgba(12, 9, 7, 0.35);
        border-bottom: 1px solid rgba(245, 245, 220, 0.08);
    }

    .cart-footer {
        border-top: 1px solid rgba(245, 245, 220, 0.08);
        border-bottom: 0;
        margin-top: auto;
    }

    .cart-kicker {
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--marron-suave);
        margin-bottom: 0.25rem;
    }

    .cart-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .cart-header h2 {
        color: var(--crema-claro);
        font-size: 1.4rem;
    }

    .cart-close {
        border: 1px solid rgba(245, 245, 220, 0.18);
        background: rgba(255, 255, 255, 0.04);
        color: var(--crema-claro);
        border-radius: 999px;
        width: 38px;
        height: 38px;
        cursor: pointer;
        font-size: 1.4rem;
        line-height: 1;
    }

    .cart-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .cart-body::-webkit-scrollbar {
        width: 8px;
    }

    .cart-body::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.06);
        border-radius: 999px;
    }

    .cart-body::-webkit-scrollbar-thumb {
        background: var(--marron-caverna);
        border-radius: 999px;
    }

    .cart-empty {
        padding: 1rem;
        border: 1px dashed rgba(245, 245, 220, 0.2);
        border-radius: 12px;
        color: rgba(253, 250, 245, 0.82);
        text-align: center;
    }

    .cart-items {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .cart-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(245, 245, 220, 0.08);
        border-radius: 14px;
        padding: 0.75rem;
    }

    .cart-item-cover {
        width: 64px;
        height: 90px;
        object-fit: cover;
        border-radius: 10px;
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.08);
    }

    .cart-item-copy {
        min-width: 0;
        flex: 1;
    }

    .cart-item-copy h3 {
        color: var(--crema-claro);
        font-size: 1rem;
        margin-bottom: 0.2rem;
    }

    .cart-item-copy p {
        color: rgba(253, 250, 245, 0.72);
        font-size: 0.92rem;
    }

    .cart-item-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.45rem;
        flex-shrink: 0;
        text-align: right;
    }

    .cart-item-meta strong {
        color: var(--marron-suave);
        font-size: 0.98rem;
    }

    .cart-remove {
        border: none;
        background: none;
        color: rgba(253, 250, 245, 0.8);
        cursor: pointer;
        font-size: 0.84rem;
        text-decoration: underline;
        text-underline-offset: 0.18rem;
    }

    .cart-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        color: rgba(253, 250, 245, 0.82);
        margin-bottom: 0.55rem;
    }

    .cart-summary-total {
        font-size: 1.08rem;
        color: var(--crema-claro);
        margin-bottom: 1rem;
    }

    .cart-checkout {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 0.95rem 1rem;
        background: var(--marron-caverna);
        color: white;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .cart-checkout:hover:not(:disabled) {
        background: #a36c42;
        transform: translateY(-1px);
    }

    .cart-checkout:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    :global(body.cart-drawer-open) {
        overflow: hidden;
    }

    :global(.cart-toast) {
        background: #241913;
        color: var(--crema-claro);
        border: 1px solid rgba(245, 245, 220, 0.14);
        border-left: 4px solid var(--marron-caverna);
        padding: 0.85rem 1rem;
        border-radius: 12px;
        box-shadow: 0 12px 26px rgba(0, 0, 0, 0.18);
        transform: translateY(8px);
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.2s ease;
        max-width: 280px;
    }

    :global(.cart-toast.visible) {
        transform: translateY(0);
        opacity: 1;
    }

    @media (max-width: 768px) {
        .cart-drawer {
            top: 180px;
            width: calc(100vw - 12px);
            max-height: calc(100vh - 210px);
        }

        .cart-item {
            align-items: flex-start;
        }

        .cart-item-meta {
            min-width: 78px;
        }
    }
</style>
